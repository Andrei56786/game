+func ter_at(id: String, tx: int, ty: int) -> int:
+	var Ld: Dictionary = D["locs"][id]
+	var w: int = Ld["w"]
+	var s: String = Ld.get("ter", "")
+	var i := ty * w + tx
+	if tx < 0 or ty < 0 or tx >= w or ty >= int(Ld["h"]) or i >= s.length():
+		return 0
+	return ("0x" + s[i]).hex_to_int()
+
+func fa_col(a: Dictionary) -> String:
+	var k: String = a["kind"]
