+## отростки на рогах оленя (faPts): чаще 8–12, королевский — 14, императорский — 16
+func fa_pts(a: Dictionary) -> int:
+	if not a.has("pts"):
+		var r := randf()
+		a["pts"] = 6 if r < 0.12 else 8 if r < 0.36 else 10 if r < 0.62 else 12 if r < 0.84 else 14 if r < 0.96 else 16
