[
{"waitFor": "SCREEN==='court' && G && COURT.p", "timeout": 60000},
{"eval": "window.clickHit = id => { const h = LAST.find(r => r.id === id); if (!h) return 'нет ' + id; const x = h.x + h.w / 2, y = h.y + h.h / 2; input.clicks.push({ x, y, ux: x, uy: y, b: 0 }); return 'ok ' + id; }; UI.win=null; UI.modals=[]; G.speed=1; G.adv = { on: 1, seen: {} }; ADV.ctx=''; ADV.cur=null; COURT.room=''; 'ok'"},
{"wait": 900},
{"expect": "ADV.cur === 'keep:Тронный зал'", "label": "в тронном зале — совет канцлера"},
{"shot": "adv_throne.png"},
{"wait": 3600},
{"eval": "COURT.p.x = 42*CT+8; COURT.p.y = 6*CT+11; COURT.path=null; snapCam(); 'ok'"},
{"wait": 700},
{"expect": "G.adv.seen['keep:Тронный зал'] && ADV.cur === 'keep:Зал совета'", "label": "прочитанный совет засчитан, в зале совета — новый"},
{"eval": "clickHit('adv_ok')"},
{"wait": 400},
{"expect": "G.adv.seen['keep:Зал совета'] && !ADV.cur", "label": "«Понятно» закрывает совет"},
{"eval": "COURT.p.x = 6*CT+8; COURT.p.y = 6*CT+11; snapCam(); 'ok'"},
{"wait": 500},
{"expect": "ADV.cur === 'keep:Библиотека'", "label": "библиотека — совет магистра"},
{"eval": "COURT.p.x = 6*CT+8; COURT.p.y = 20*CT+11; snapCam(); 'ok'"},
{"wait": 500},
{"expect": "!G.adv.seen['keep:Библиотека'] && ADV.cur === 'keep:Королевские покои'", "label": "мельком прочитанный совет вернётся"},
{"eval": "clickHit('adv_off')"},
{"wait": 300},
{"expect": "G.adv.on === 0 && !ADV.cur", "label": "«Без советов» выключает подсказки"},
{"eval": "G.adv.on = 1; leaveCourt(null); 'ok'"},
{"wait": 900},
{"expect": "SCREEN === 'map' && ADV.cur === 'map'", "label": "за воротами — совет маршала"},
{"shot": "adv_map.png"},
{"eval": "clickHit('adv_ok'); enterCourt(); 'ok'"},
{"wait": 900},
{"expect": "SCREEN==='court' && COURT.loc==='yard' && /^yard:(Ворота замка|Двор замка)$/.test(ADV.cur)", "label": "во дворе — совет при въезде"},
{"shot": "adv_yard.png"},
{"eval": "clickHit('adv_ok'); huntStart('boar', null); 'ok'"},
{"wait": 2500},
{"expect": "COURT.loc==='forest' && ADV.cur === 'hunt'", "label": "на охоте — совет ловчего"},
{"shot": "adv_hunt.png"},
{"print": "Object.keys(G.adv.seen).join(', ')"}
]
